{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://refpath.github.io/nuif/schema/documentation-catalog-v1.json",
  "title": "NUIF documentation catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site",
    "limits",
    "frontmatter_required",
    "exclude",
    "manuscript",
    "sections"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "repository_url", "canonical_url", "maturity"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "repository_url": {"type": "string", "format": "uri"},
        "canonical_url": {"type": "string", "format": "uri"},
        "maturity": {"type": "string", "minLength": 1}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_bytes", "frontmatter_bytes"],
      "properties": {
        "document_bytes": {"type": "integer", "minimum": 1024},
        "frontmatter_bytes": {"type": "integer", "minimum": 256}
      }
    },
    "frontmatter_required": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "exclude": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "manuscript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle", "authors", "version", "date", "status", "abstract", "sources"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string", "minLength": 1},
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "version": {"type": "string", "minLength": 1},
        "date": {"type": "string", "format": "date"},
        "status": {"type": "string", "minLength": 1},
        "abstract": {"type": "string", "minLength": 1},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/section"}
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "paths"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "title": {"type": "string", "minLength": 1},
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
